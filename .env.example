# Copier ce fichier en .env.local (ignoré par git) et le remplir.
# Ces variables sont lues au moment du build (npm run build) : sur Coolify,
# les déclarer comme variables de build.
# Elles finissent dans le JavaScript envoyé aux visiteurs : ce ne sont pas des secrets,
# mais elles sont propres à mon déploiement et restent donc hors du dépôt.

# Formulaire de contact (EmailJS) — restreindre les domaines autorisés dans le tableau de bord EmailJS
REACT_APP_EMAILJS_SERVICE=
REACT_APP_EMAILJS_TEMPLATE=
REACT_APP_EMAILJS_PUBLIC_KEY=

# URL publique du CV en PDF (le fichier n'est pas dans le dépôt). Vide = bouton masqué.
REACT_APP_CV_URL=

# Google Analytics (format G-XXXXXXX). Vide = aucun suivi.
REACT_APP_GA_ID=

# Jeu SEVUX et son classement (valeurs par défaut si vide)
REACT_APP_GAME_URL=https://sevux.netlify.app/
REACT_APP_SCORES_API=https://sevux.netlify.app/api/scores
